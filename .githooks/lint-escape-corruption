#!/bin/sh
# Escape-corruption lint -- the enforcement R22 has always lacked.
#
# R22 forbids authoring files via shell interpolation. When that rule is broken,
# backslash escapes in the content get interpreted and silently damage the text.
# Observed repeatedly in this workspace, in TWO variants:
#
#   Variant A -- the escape survives as a literal control byte:
#       "Pytest in \tests/"      -> "Pytest in <TAB>ests/"
#       "Execute \run_command"   -> "Execute <CR>un_command"
#
#   Variant B -- the escape is consumed entirely, eating the next character,
#     leaving clean UTF-8 that merely says the wrong thing. Only a known-token
#     dictionary finds this one.
#
# WHY THE BYTE SCAN IS PYTHON AND NOT grep
# ----------------------------------------
# Git Bash grep opens files in text mode. On a CRLF file it strips every CR
# before matching, including a mid-line one. Measured on this machine:
#
#   file                          python 0x0d count    grep -cP '\x0d'
#   LF endings, mid-line CR                 1                  1
#   CRLF endings, mid-line CR               4                  0   <-- silent miss
#
# So a grep-based CR check reports clean on exactly the Windows files most
# likely to be damaged. Read the bytes instead. A CR is only legitimate as
# part of a CRLF pair; a CR not followed by LF is corruption.
#
# Usage:  lint-escape-corruption [file ...]   # defaults to rules/ and .agents/ *.md
# Exit 0 clean, 1 if anything is flagged.

fail=0

if [ "$#" -gt 0 ]; then
  files=$*
else
  files=$(find rules .agents -name '*.md' -type f 2>/dev/null)
fi

PY=python
command -v python >/dev/null 2>&1 || PY=python3

for f in $files; do
  [ -f "$f" ] || continue
  case "$f" in *.md) ;; *) continue ;; esac

  # ---- Variant A: byte-level scan, line-ending agnostic ----
  out=$("$PY" - "$f" <<'PYEOF'
import sys

path = sys.argv[1]
with open(path, 'rb') as fh:
    data = fh.read()

problems = []

# Any C0 control byte is corruption unless it is legitimate structure.
# Legitimate: LF (0x0a); CR (0x0d) ONLY as part of a CRLF pair; TAB (0x09) only as
# leading indentation, checked separately below.
# Everything else is an interpreted escape that survived into the file:
#   \b -> 0x08   \f -> 0x0c   \v -> 0x0b   \a -> 0x07   \e -> 0x1b
# Observed live: "```bash" -> "`" + 0x08 + "ash", which silently kills a code fence.
_NAMES = {0x07: r'\a BEL', 0x08: r'\b BACKSPACE', 0x0b: r'\v VTAB',
          0x0c: r'\f FORMFEED', 0x1b: r'\e ESC'}
for i, b in enumerate(data):
    if b == 0x0d:
        if data[i + 1:i + 2] != b'\n':
            line = data.count(b'\n', 0, i) + 1
            problems.append((line, 'stray CR (0x0d) not part of a CRLF pair'))
    elif b < 0x20 and b not in (0x09, 0x0a):
        line = data.count(b'\n', 0, i) + 1
        name = _NAMES.get(b, 'control byte 0x%02x' % b)
        problems.append((line, 'stray %s (0x%02x) from an interpreted escape' % (name, b)))

# A TAB is legitimate as leading indentation. A TAB after visible content on the
# same line is how "\tword" degrades.
for raw in enumerate(data.split(b'\n'), start=1):
    num, ln = raw
    ln = ln.rstrip(b'\r')
    if b'\t' in ln:
        before = ln.split(b'\t', 1)[0]
        if before.strip():
            problems.append((num, 'TAB (0x09) after visible content, not indentation'))

for num, msg in problems[:5]:
    print("%d: %s" % (num, msg))
sys.exit(1 if problems else 0)
PYEOF
)
  if [ -n "$out" ]; then
    echo "escape-lint: $f -- stray control byte from an interpreted escape"
    printf '%s\n' "$out" | sed 's/^/    /'
    fail=1
  fi

  # ---- Variant B: known tokens with a leading character eaten by an escape ----
  # Extend this list as new instances are found. Each is <damaged> -> <intended>.
  #
  # PowerShell is the usual source, not printf. In a double-quoted PS string the
  # backtick is the escape character, and it recognizes: `0 `a `b `e `f `n `r `t `v.
  # So "```bash" collapses to one literal backtick, then `b -> BACKSPACE, giving
  # "`" + 0x08 + "ash"; strip the control byte anywhere downstream and "`ash" is
  # left. The matching "```" fence collapses to a lone "`". Fenced code blocks stop
  # rendering and the byte scan sees nothing. Only the token finds these.
  #
  # Note "rchitect" -- observed 2026-09-03 in skill-router/SKILL.md as
  # "| " + 0x07 + "rchitect |", i.e. `a ate the 'a' AND left a BEL. Damage can be
  # Variant A and Variant B at once; catching either alone would have missed half.
  #
  # A lone backtick on its own line is a mangled closing fence. Verified zero
  # legitimate occurrences across rules/ and .agents/ before adding it. Use
  # [[:space:]] and not [ \t]: POSIX ERE does not expand \t inside a bracket
  # expression, so [ \t] silently means "space, backslash, or the letter t".
  hits=$(grep -nE '\bun_command\b|\bests/|^ame:|\berify_|\besults\.json|\bsc -b\b|\brchitect\b|\bgents/|\benchmark_harness\b|\bode_modules\b|`ash$|`ash[^a-z]|^[[:space:]]*`[[:space:]]*$' "$f" 2>/dev/null)
  if [ -n "$hits" ]; then
    echo "escape-lint: $f -- token looks truncated by an interpreted escape"
    printf '%s\n' "$hits" | head -5 | sed 's/^/    /'
    echo "    (un_command->run_command  ests/->tests/  ame:->name:  sc -b->tsc -b)"
    echo "    (rchitect->architect  gents/->agents/  \`ash->\`\`\`bash  lone \` -> \`\`\`)"
    fail=1
  fi
done

if [ "$fail" -eq 1 ]; then
  echo ""
  echo "escape-lint: authored text was damaged by an interpreted backslash escape."
  echo "Per R22, do not author files with shell interpolation (cat <<EOF, echo >, sed)."
  echo "Rewrite the file with a native editor/agent file tool and commit again."
  exit 1
fi

exit 0
