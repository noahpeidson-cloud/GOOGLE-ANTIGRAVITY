#!/bin/sh
# Rule-number collision lint -- the enforcement rules/proposed/README.md asks for
# but could not provide.
#
# The README tells agents to "read rules/03_multi_agent_guardrails.md for the
# current highest number before claiming one". That is a request, not a control.
# It has already failed twice, measurably:
#
#   R38  rules/03 "VS Code Deprecation & GitKraken Swarm Lane Architecture"
#        GEMINI.md "The Fail-Fast API Guardrail (Anti-Mocking)"
#   R39  rules/03 "Git Ownership & Branch Discipline"
#        GEMINI.md "The Terminal Confidence Block Guardrail"
#
# Two unrelated mandates share each number. An agent told to "follow R39" cannot
# know which one it was handed. This lint makes the next one impossible.
#
# WHAT IS A COLLISION AND WHAT IS NOT
# -----------------------------------
# The same rule is deliberately restated in more than one file: rules/01 and
# GEMINI.md both carry R16, R17, R18, R26. That is duplication, not collision,
# and blocking it would block every commit. Titles are compared after
# normalization (lowercased, punctuation stripped, a leading "The " dropped), and
# a shorter title that is a prefix of a longer one counts as the same rule --
# that is what lets R36 "GCP Authentication Guardrail" and R36 "GCP
# Authentication Guardrail (MS Store CLI)" pass.
#
# Only two materially different titles on one number fail.
#
# Pre-existing collisions live in .githooks/rule-collisions.allow with a reason.
# The allowlist is a record of debt, not an amnesty: adding a line is a change a
# reviewer sees.
#
# WHAT IT CHECKS IN rules/proposed/
# ---------------------------------
# A proposal declares its number in frontmatter, and the number is checked
# against reality:
#   type: new        -> the number MUST still be free in rules/
#   type: amendment  -> the number MUST already exist in rules/
# An amendment that targets a nonexistent rule, and a new rule that squats a
# taken number, are the two ways rules/proposed/ silently rots.
#
# Usage:  lint-rule-collisions        # scans the whole repo; takes no arguments
# Exit 0 clean, 1 if anything is flagged.

set -e

root=$(git rev-parse --show-toplevel 2>/dev/null) || root=.
cd "$root"

PY=python
command -v python >/dev/null 2>&1 || PY=python3

"$PY" - <<'PYEOF'
import glob
import os
import re
import sys

# Files that carry rules in force. rules/*.md does not recurse, so rules/proposed
# is deliberately excluded here and handled separately below.
CANONICAL_GLOBS = ['rules/*.md', 'GEMINI.md', 'CLAUDE.md']
PROPOSED_GLOB = 'rules/proposed/*.md'
ALLOW_FILE = '.githooks/rule-collisions.allow'

HEADING = re.compile(r'^#{1,6}[ \t]+(R[-A-Za-z0-9]*\d)\.[ \t]*(.*?)[ \t\r]*$')
FRONTMATTER_KEY = re.compile(r'^([A-Za-z_]+):[ \t]*(.*?)[ \t\r]*$')

problems = []


def canon(token):
    """R02, R2 and r-02 all key to R2. R-APV-01 keys to RAPV1."""
    t = token.strip().upper()
    m = re.match(r'^(.*?)(\d+)$', t)
    if not m:
        return t
    return '%s%d' % (re.sub(r'[^A-Z]', '', m.group(1)), int(m.group(2)))


def norm(title):
    t = re.sub(r'[^a-z0-9]+', ' ', title.lower()).strip()
    return t[4:] if t.startswith('the ') else t


def same_rule(titles):
    """True when every pair is a restatement rather than a different mandate."""
    ts = sorted(set(titles))
    for i, a in enumerate(ts):
        for b in ts[i + 1:]:
            if not (a.startswith(b) or b.startswith(a)):
                return False
    return True


def read_lines(path):
    with open(path, encoding='utf-8', errors='replace') as fh:
        return fh.read().split('\n')


allowed = set()
if os.path.exists(ALLOW_FILE):
    for raw in read_lines(ALLOW_FILE):
        entry = raw.split('#', 1)[0].strip()
        if entry:
            allowed.add(canon(entry))

# ---- Pass 1: every rule heading in a file that is in force ----
found = {}
for pattern in CANONICAL_GLOBS:
    for path in sorted(glob.glob(pattern)):
        for num, line in enumerate(read_lines(path), start=1):
            m = HEADING.match(line)
            if m:
                found.setdefault(canon(m.group(1)), []).append(
                    (m.group(1), m.group(2), path, num))

for key in sorted(found):
    sightings = found[key]
    if len(sightings) < 2 or same_rule([norm(s[1]) for s in sightings]):
        continue
    if key in allowed:
        continue
    problems.append('%s is claimed by two different rules:' % key)
    for token, title, path, num in sightings:
        problems.append('    %s:%d  %s. %s' % (path, num, token, title))
    problems.append('    Renumber one, or record the conflict in %s.' % ALLOW_FILE)

# ---- Pass 2: proposals must declare a number, and the number must be real ----
claimed_by = {}
for path in sorted(glob.glob(PROPOSED_GLOB)):
    if os.path.basename(path).lower() == 'readme.md':
        continue

    lines = read_lines(path)
    meta = {}
    if lines and lines[0].strip() == '---':
        for line in lines[1:]:
            if line.strip() == '---':
                break
            m = FRONTMATTER_KEY.match(line)
            if m:
                meta[m.group(1).lower()] = m.group(2)

    kind = meta.get('type', '').lower()
    if kind not in ('new', 'amendment'):
        problems.append('%s: frontmatter needs "type: new" or "type: amendment".' % path)
        problems.append('    See rules/proposed/README.md for the required block.')
        continue

    field = 'proposal' if kind == 'new' else 'amends'
    token = meta.get(field, '')
    if not token:
        problems.append('%s: "type: %s" requires a "%s:" number.' % (path, kind, field))
        continue

    key = canon(token)

    filename_num = re.match(r'^(R[-A-Za-z0-9]*\d)[_.]', os.path.basename(path))
    if filename_num and canon(filename_num.group(1)) != key:
        problems.append('%s: filename says %s but frontmatter says %s: %s.'
                        % (path, filename_num.group(1), field, token))

    if kind == 'new':
        if key in found:
            taken = found[key][0]
            problems.append('%s proposes %s, but %s is already in force:'
                            % (path, token, token))
            problems.append('    %s:%d  %s. %s' % (taken[2], taken[3], taken[0], taken[1]))
            problems.append('    Pick the next free number, or switch to "type: amendment".')
        if key in claimed_by:
            problems.append('%s and %s both propose %s. One must renumber.'
                            % (claimed_by[key], path, token))
        claimed_by[key] = path
    else:
        if key not in found:
            problems.append('%s amends %s, but no rule %s exists in rules/.'
                            % (path, token, token))
            problems.append('    An amendment must target a rule that is in force.')

for line in problems:
    print(line)
sys.exit(1 if problems else 0)
PYEOF
status=$?

if [ "$status" -ne 0 ]; then
  echo ""
  echo "rule-lint: a rule number does not mean one thing."
  echo "A number that resolves to two mandates makes every citation of it ambiguous."
  echo "Amend rules through rules/proposed/ -- see rules/proposed/README.md."
  exit 1
fi

exit 0
