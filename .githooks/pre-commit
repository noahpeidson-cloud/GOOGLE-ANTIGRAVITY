#!/bin/sh
# Repo hygiene guard -- see rules/03_multi_agent_guardrails.md R39.
# Blocks the three classes of mistake that hit this repo in one session:
# secrets, node_modules, and files that match .gitignore but got force-added.
# Applies to any agent/tool that runs `git commit` (core.hooksPath is versioned).

set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

fail=0

# 1. node_modules should never be staged.
node_modules_hits=$(printf '%s\n' "$staged" | grep -E 'node_modules/' || true)
if [ -n "$node_modules_hits" ]; then
  echo "pre-commit: blocked -- staged files under node_modules/:"
  printf '%s\n' "$node_modules_hits" | sed 's/^/  /'
  fail=1
fi

# 2. Filenames matching known secret patterns.
secret_hits=$(printf '%s\n' "$staged" | grep -E '(^|/)\.env(\..*)?$|credentials.*\.json$|client_secret.*\.json$|token.*\.json$|\.pem$|\.key$|\.pfx$|\.p12$|\.pickle$|\.auth_token$' | grep -v '\.env\.example$' || true)
if [ -n "$secret_hits" ]; then
  echo "pre-commit: blocked -- staged files match a secret pattern from .gitignore:"
  printf '%s\n' "$secret_hits" | sed 's/^/  /'
  fail=1
fi

# 3. Anything staged that also matches .gitignore (the "tracked-but-ignored" bug).
ignored_hits=""
for f in $staged; do
  if git check-ignore -q -- "$f" 2>/dev/null; then
    ignored_hits="$ignored_hits$f\n"
  fi
done
if [ -n "$ignored_hits" ]; then
  echo "pre-commit: blocked -- staged files match .gitignore (force-added?):"
  printf "$ignored_hits" | sed 's/^/  /'
  fail=1
fi

# 4. Staged markdown checked for escape-corruption (interpreted backslash
#    escapes from R22 violations -- see .githooks/lint-escape-corruption).
md_staged=$(printf '%s\n' "$staged" | grep '\.md$' || true)
if [ -n "$md_staged" ]; then
  if ! sh "$(dirname "$0")/lint-escape-corruption" $md_staged; then
    fail=1
  fi
fi

# 5. Rule-number collisions. Inherently cross-file, so this scans the whole repo
#    rather than the staged set -- but only when the commit touches a file that
#    can carry a rule, so unrelated commits are never blocked on it.
rule_staged=$(printf '%s\n' "$staged" | grep -E '^(rules/|GEMINI\.md$|CLAUDE\.md$)' || true)
if [ -n "$rule_staged" ]; then
  if ! sh "$(dirname "$0")/lint-rule-collisions"; then
    fail=1
  fi
fi

# 6. Verification claims in staged rules/.agents markdown must state a boundary.
verify_staged=$(printf '%s\n' "$staged" | grep -E '^(rules/|\.agents/).*\.md$' || true)
if [ -n "$verify_staged" ]; then
  if ! sh "$(dirname "$0")/lint-verification-claims" $verify_staged; then
    fail=1
  fi
fi

# 7. Strict rules must disclose their own bypass.
if [ -n "$rule_staged" ]; then
  if ! sh "$(dirname "$0")/lint-rule-bypass" $(printf '%s\n' "$staged" | grep -E '^rules/[^/]+\.md$' || true); then
    fail=1
  fi
fi

# 8. Review-request handoffs must use resolvable, stable identifiers.
handoff_staged=$(printf '%s\n' "$staged" | grep -E '^\.claude/review-requests/.*\.md$' || true)
if [ -n "$handoff_staged" ]; then
  if ! sh "$(dirname "$0")/lint-handoff-identifiers" $handoff_staged; then
    fail=1
  fi
fi

if [ "$fail" -eq 1 ]; then
  echo ""
  echo "pre-commit: fix the above, or use 'git commit --no-verify' if you are certain this is intentional."
  exit 1
fi

exit 0
