{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote -v:*)",
      "Bash(git config --get:*)",
      "Bash(git cat-file:*)",
      "Bash(git rev-parse:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(du:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git checkout .:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git filter-repo:*)",
      "Bash(git filter-branch:*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*credentials*.json)",
      "Read(./**/client_secret*.json)",
      "Read(./**/token*.json)",
      "Read(./**/.auth_token)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./archive/**)",
      "Read(./.archive/**)"
    ]
  },
  "enabledMcpjsonServers": [
    "filesystem"
  ],
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
