cd /d "d:\GOOGLE ANTIGRAVITY\prompt_library" && python -c "import sqlite3; c=sqlite3.connect('prompt_templates.db'); c.row_factory=sqlite3.Row; rows=c.execute('SELECT template_id, template_name, substr(rendered_prompt,1,60) AS rp FROM history ORDER BY created_at DESC').fetchall(); print('HISTORY ROWS:', len(rows)); [print('-', dict(r)) for r in rows]; print('---'); print('Templates count:', c.execute('SELECT COUNT(*) FROM templates').fetchone()[0])"