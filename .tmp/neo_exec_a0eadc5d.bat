python -c "import sqlite3; con=sqlite3.connect(r'd:\GOOGLE ANTIGRAVITY\prompt_library\prompt_templates.db'); cur=con.cursor(); print('TABLES:', [r[0] for r in cur.execute(\"SELECT name FROM sqlite_master WHERE type='table'\").fetchall()]); print('TEMPLATE COUNT:', cur.execute('SELECT COUNT(*) FROM templates').fetchone()[0]); print('HISTORY COUNT:', cur.execute('SELECT COUNT(*) FROM history').fetchone()[0]); print('TEMPLATES:'); [print(r) for r in cur.execute('SELECT id,name,category FROM templates').fetchall()]"