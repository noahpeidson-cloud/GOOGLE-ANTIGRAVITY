python -c "import urllib.request, json; r=urllib.request.urlopen('http://localhost:8090/', timeout=10); html=r.read().decode(); print('UI status:', r.status, 'len:', len(html), 'has Prompt Library:', 'Prompt Library' in html); r2=urllib.request.urlopen('http://localhost:8090/api/templates', timeout=10); d=json.loads(r2.read().decode()); print('templates status:', r2.status, 'count:', len(d['templates']))"