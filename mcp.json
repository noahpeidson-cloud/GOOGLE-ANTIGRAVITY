{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/schema/main/schema.json",
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "d:\\GOOGLE ANTIGRAVITY"
      ],
      "description": "Local workspace filesystem provider with strict path sandboxing"
    },
    "sqlite-inventory": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-sqlite-npx",
        "d:\\GOOGLE ANTIGRAVITY\\sports_cards\\card_inventory.db"
      ],
      "description": "Card valuation and inventory SQLite database provider"
    },
    "sqlite-manifest": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-sqlite-npx",
        "d:\\GOOGLE ANTIGRAVITY\\content_creation\\media_pipeline\\ingestion\\manifest.db"
      ],
      "description": "8K APV video ingestion manifest and integrity tracking SQLite provider"
    }
  }
}
