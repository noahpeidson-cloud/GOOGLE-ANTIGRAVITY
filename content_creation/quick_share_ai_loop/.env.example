# =============================================================================
# Quick Share AI Loop Environment Variables Template
# Copy this file to .env and replace placeholders with real credentials.
# =============================================================================

# Gemini API Key for Multimodal AI Inference (gemini-3.6-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL / Google Cloud SQL Connection Parameters
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_secure_password_here
PG_DB=media_analytics
PG_SSLMODE=prefer

# Connection Pool Settings
PG_MIN_CONN=1
PG_MAX_CONN=10
PG_CONNECT_TIMEOUT=10
